# Copy to .env and fill in real values.
# Docker Compose sets DATABASE_URL automatically from root .env.
DATABASE_URL=postgresql://teached:password@db:5432/teached
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN
