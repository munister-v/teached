# Copy this file to .env on the VPS and replace every CHANGE_ME value.

NODE_ENV=production
PORT=4000

# PostgreSQL inside docker-compose. Keep the password URL-safe or set DATABASE_URL manually in docker-compose.yml.
POSTGRES_DB=teached
POSTGRES_USER=teached
POSTGRES_PASSWORD=CHANGE_ME_LONG_DB_PASSWORD
PGSSL=false

# Public domains that are allowed to call the API.
# Example: https://teached.munister.com.ua,https://munister.com.ua
ALLOWED_ORIGINS=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN

# Security secrets. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ADMIN_SECRET=CHANGE_ME_LONG_RANDOM_ADMIN_SECRET

# Optional Stripe billing. Leave blank until real payment keys are ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCHOOL_PRICE_ID=

# Optional push notification VAPID keys.
VAPID_PUBLIC=
VAPID_PRIVATE=
